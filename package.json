{
  "name": "jimmy.codes",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "build:resume": "pandoc public/resume.md -o public/resume.pdf --pdf-engine=xelatex -V geometry:margin=0.85in -V fontsize=11pt -V mainfont=\"Arial\"",
    "check": "bun run --sequential knip lint build typecheck coverage",
    "coverage": "vitest run --coverage",
    "deps:dedupe": "rm -rf node_modules && rm bun.lock && bun install",
    "deps:up": "bunx npm-check-updates -ui",
    "dev": "bunx --bun astro dev",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "fix:lint": "bun run --parallel 'fix:lint:*'",
    "fix:lint:biome": "biome lint --fix .",
    "fix:lint:md": "markdownlint --fix \"src/content/**/*.{md,mdx}\"",
    "fmt": "bun run --parallel 'fmt:*'",
    "fmt:biome": "biome format --write .",
    "fmt:prettier": "prettier --experimental-cli --write \"**/*.{astro,md,mdx}\" --ignore-path .gitignore",
    "knip": "KNIP=true knip",
    "lint": "bun run --parallel 'lint:*'",
    "lint:biome": "biome lint .",
    "lint:md": "markdownlint \"src/content/**/*.{md,mdx}\"",
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "preview": "astro preview",
    "test": "vitest",
    "typecheck": "tsc && astro check"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "dependencies": {
    "astro-mermaid": "2.1.0",
    "mermaid": "12.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.11",
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@emnapi/runtime": "1.11.3",
    "@iconify-json/devicon": "1.2.68",
    "@iconify-json/logos": "1.2.14",
    "@iconify-json/lucide": "1.2.137",
    "@iconify-json/simple-icons": "1.2.97",
    "@iconify-json/skill-icons": "1.2.4",
    "@iconify/tailwind4": "1.2.3",
    "@playwright/test": "1.63.0",
    "@shikijs/colorized-brackets": "4.4.3",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@vercel/og": "1.0.3",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vite-pwa/astro": "1.2.0",
    "@vitest/coverage-v8": "5.0.2",
    "astro": "7.3.5",
    "astro-expressive-code": "0.44.2",
    "daisyui": "5.7.46",
    "expressive-code-twoslash": "0.6.1",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-callouts": "2.2.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "rehype-unwrap-images": "1.0.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "yaml": "3.0.0-2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "lefthook",
    "sharp"
  ]
}

---
import { Font } from "astro:assets";
import { FATHOM_SITE_ID } from "astro:env/client";

import { pwaAssetsHead } from "virtual:pwa-assets/head";
import { pwaInfo } from "virtual:pwa-info";
import type { ComponentProps } from "astro/types";

import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import Seo from "@/components/Seo.astro";
import ThemeScript from "@/components/ThemeScript.astro";
import { pages } from "@/configs/pages";
import { urls } from "@/configs/urls";

import "@/styles/global.css";

type Props = ComponentProps<typeof Seo> & {
  extraLd?: Record<string, unknown>[];
  alternates?: { type: string; path: string }[];
};

const { extraLd = [], alternates = [], ...seo } = Astro.props;
const { title, description } = seo;

const canonical = Astro.url.href.replace(/\/$/, "");

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": `${urls.site}/#website`,
      "@type": "WebSite",
      "description": pages.site.description,
      "inLanguage": "en-US",
      "name": pages.site.title,
      "publisher": { "@id": `${urls.site}/#person` },
      "url": urls.site,
    },
    {
      "@id": `${urls.site}/#person`,
      "@type": "Person",
      "name": "Jimmy Guzman Moreno",
      "sameAs": [urls.GitHub, urls.LinkedIn],
      "url": urls.site,
    },
    {
      "@id": `${canonical}#webpage`,
      "@type": "WebPage",
      description,
      "inLanguage": "en-US",
      "isPartOf": { "@id": `${urls.site}/#website` },
      "name": title,
      "url": canonical,
    },
    ...extraLd,
  ],
});
---

<!doctype html>
<html lang="en" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <Seo {...seo} />

    <ThemeScript />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {pwaAssetsHead.themeColor && (
      <meta name="theme-color" content={pwaAssetsHead.themeColor.content} />
    )}

    {pwaAssetsHead.links.map((link) => (
      <link {...link} />
    ))}

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

    {alternates.map(({ type, path }) => (
      <link rel="alternate" type={type} href={`${urls.site}${path}`} />
    ))}

    <meta name="generator" content={Astro.generator} />

    {FATHOM_SITE_ID && (
      <script
        is:inline
        src="https://cdn.usefathom.com/script.js"
        data-site={FATHOM_SITE_ID}
        defer
      ></script>
    )}

    <Font
      cssVariable="--font-mono"
      preload={[
        { style: "normal", weight: 400 },
        { style: "normal", weight: 500 },
      ]}
    />

    <script>
      import { registerSW } from "virtual:pwa-register";

      registerSW({ immediate: true });
    </script>
    <script type="application/ld+json" is:inline set:html={jsonLd}></script>
  </head>
  <body
    class="flex min-h-dvh-safe flex-col justify-between px-safe-or-4"
    tabindex="-1"
  >
    <Nav />
    <slot />
    <Footer />
  </body>
</html>

---
import BackLink from "@/components/BackLink.astro";

interface Props {
  heading: string;
  back?: {
    title: Lowercase<string>;
    url: string;
  };
}

const { heading, back } = Astro.props;
---

<main
  class="prose py-safe-or-12 px-safe-or-4 xl:prose-lg prose-a:underline prose-a:decoration-neutral/64 prose-a:decoration-dashed prose-a:decoration-1 prose-a:underline-offset-[3px] [&_a:hover]:decoration-base-content mx-auto w-full max-w-3xl grow items-start space-y-6 [view-transition-name:main] [&_a]:transition-[text-decoration-color,text-decoration-style] [&_a]:duration-200 [&_a]:ease-in-out [&_a:hover]:decoration-solid"
  aria-labelledby="page-title"
>
  {back && <BackLink url={back.url} title={back.title} />}
  <h1 class="[view-transition-name:title]" id="page-title">
    {heading}
  </h1>
  <slot />
</main>

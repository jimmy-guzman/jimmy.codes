---
import { prettyDate } from "../utils/content";

interface Props {
  publishDate: Date;
  minutes: number;
  class?: string;
}

const { publishDate, minutes, class: className = "" } = Astro.props;
---

<span class:list={[className, "flex items-center gap-2"]}>
  <time datetime={publishDate.toISOString()}>{prettyDate(publishDate)}</time>
  <span aria-hidden="true">•</span>
  <span>{`${minutes} min read`}</span>
</span>

{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": [
      "@unplugin-pwa/core/client",
      "@unplugin-pwa/core/info",
      "@unplugin-pwa/core/pwa-assets"
    ]
  },
  "exclude": ["dist", "coverage"],
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"]
}

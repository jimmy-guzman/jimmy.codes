{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "destination": "/index.md",
      "has": [
        { "key": "accept", "type": "header", "value": "(.*)text/markdown(.*)" }
      ],
      "permanent": false,
      "source": "/"
    },
    {
      "destination": "/:page.md",
      "has": [
        { "key": "accept", "type": "header", "value": "(.*)text/markdown(.*)" }
      ],
      "permanent": false,
      "source": "/:page(about|uses|blog)"
    },
    {
      "destination": "/blog/:path.md",
      "has": [
        { "key": "accept", "type": "header", "value": "(.*)text/markdown(.*)" }
      ],
      "permanent": false,
      "source": "/blog/:path((?!rss\\.xml$)(?!.*\\.md$).+)"
    }
  ]
}
